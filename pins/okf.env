# Pinned okf release: the fork that accepts datetime stale_after (okfcli#34;
# upstream pull request okfcli/okf#39). `compass okf install` downloads
# https://github.com/$OKF_RELEASE_REPO/releases/download/$OKF_TAG/okf_${OKF_VERSION}_<os>_<arch>.tar.gz
# and refuses it unless its sha256 matches the value below.
# OKF_RELEASE_REPO is left unset: the fork lives at $OKF_ORG/okf (config.env).
# Drop the fork once upstream releases the fix (plan decision 5).
OKF_TAG=v0.5.0-tuan-nng.1
OKF_VERSION=0.5.0-tuan-nng.1
OKF_SHA256_linux_amd64=cadd655b862253b5acb048e2442dfd35ba597234f3a9ea621c7d21c6f57ebc4f
OKF_SHA256_linux_arm64=db32f368ecf0bfb7c20181d384ef0b0ba615a457c872c76c77191ea404aed817
OKF_SHA256_darwin_amd64=178256c2bd2ecb798ac2c05a5385415715ccf2ae889ce7ee37fc4e083985f070
OKF_SHA256_darwin_arm64=c3c688cb24f6ff810a7ae5b83c7ba78b434a84b0c6cc8d49f9d59c029c4c4b87
